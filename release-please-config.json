{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "tag-separator": "-",
  "packages": {
    "component": {
      "release-type": "simple",
      "component": "component",
      "package-name": "component",
      "extra-files": ["sample/now.yaml"]
    },
    "service": {
      "release-type": "simple",
      "component": "service",
      "package-name": "service",
      "extra-files": ["sample/now.yaml"]
    },
    ".": {
      "release-type": "simple",
      "component": "bundle",
      "package-name": "bundle",
      "version-file": "bundle/version.txt",
      "changelog-path": "bundle/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "bundle/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
